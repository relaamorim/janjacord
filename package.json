{
  "name": "janjacord",
  "productName": "JanjaCord",
  "version": "1.12.0",
  "repository": "https://github.com/relaamorim/janjacord.git",
  "description": "Salas de voz com compartilhamento de tela em Full HD, estilo Discord",
  "main": "main.js",
  "author": "Pedro Amorim",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "publicar": "electron-builder --win --publish always",
    "compilar-audio": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /optimize /target:exe /platform:anycpu /out:bin/janjacord-audio.exe nativo/janjacord-audio.cs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bgamification.mydisc",
    "productName": "JanjaCord",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "bin/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "relaamorim",
      "repo": "janjacord",
      "releaseType": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "JanjaCord"
    }
  }
}
